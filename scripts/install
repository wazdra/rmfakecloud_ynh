#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

storage_url="https://$domain"
jwt_secret_key=$(ynh_string_random --length=48)
loglevel="info"

# rmfakecloud strips '-' when creating an account but not when looking one up,
# so resolve the real login name here
admin_login="${admin//-/}"

ynh_app_setting_set --key=storage_url --value="$storage_url"
ynh_app_setting_set --key=jwt_secret_key --value="$jwt_secret_key"
ynh_app_setting_set --key=loglevel --value="$loglevel"
ynh_app_setting_set --key=admin_login --value="$admin_login"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

#=================================================
# BUILD THE APP
#=================================================
ynh_script_progression "Building $app..."

rmfakecloud_build

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

rmfakecloud_config_add

#=================================================
# CREATE THE ADMIN ACCOUNT
#=================================================
ynh_script_progression "Creating $app's administrator account..."

# Must happen before the service is reachable: the app turns whichever
# credentials arrive first into a permanent admin. Keep -a and -s.
ynh_hide_warnings ynh_exec_as_app env DATADIR="$data_dir" \
	"$install_dir/rmfakecloud" setuser -u "$admin_login" -p "$password" -a -s

if [ "$admin_login" != "$admin" ]; then
	ynh_print_warn "rmfakecloud does not accept '-' in account names: log in as '$admin_login', not '$admin'."
fi

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx
ynh_config_add_systemd

yunohost service add "$app" --description="Cloud service for reMarkable devices"

ynh_config_add_fail2ban --logpath="/var/log/nginx/$domain-access.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="HTTP listening on port" --log_path=systemd

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
